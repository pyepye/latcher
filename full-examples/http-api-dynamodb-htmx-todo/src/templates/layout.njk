<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    {# HTMX drops 4xx and 5xx responses by default. This shows the #error part of the error page in #errors #}
    <meta name="htmx-config" content='{
      "responseHandling": [
        { "code": "204", "swap": false },
        { "code": "[23]..", "swap": true },
        { "code": "[45]..", "swap": true, "error": true, "target": "#errors", "select": "#error", "swapOverride": "innerHTML" }
      ]
    }'>
    <title>{{ title }} | Latcher to-dos</title>
    <script
      src="https://cdn.jsdelivr.net/npm/htmx.org@2.0.11/dist/htmx.min.js"
      integrity="sha384-2OatzQy1H+Zd/IIrjr1TcuDGqLXeHhbooAyJY1KdQMKnr4LZ22k31GBLdYKHmVjg"
      crossorigin="anonymous"
    ></script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/alpinejs@3.17.5/dist/cdn.min.js"
      integrity="sha384-FYLKjwG3aohNhNZoVG8sY/5ntunm+MqylL90Q+rT3OM7AwV9/BKFjk/RjoIpIgsI"
      crossorigin="anonymous"
    ></script>
    <style>
      body { font-family: system-ui, sans-serif; background: #f4f4f5; color: #18181b; margin: 0; }
      main { max-width: 36rem; margin: 3rem auto; padding: 1.5rem; background: #fff; border-radius: 0.5rem; }
      h1 { margin-top: 0; }
      input[type=text] { padding: 0.4rem; font-size: 1rem; }
      button { cursor: pointer; }
      form.new-todo { display: flex; gap: 0.5rem; }
      form.new-todo input { flex: 1; }
      .hint { color: #71717a; font-size: 0.85rem; }
      .hint.over { color: #dc2626; }
      .filters { display: flex; gap: 0.5rem; margin: 1rem 0; }
      .filters button[aria-pressed=true] { font-weight: bold; }
      ul.todos { list-style: none; padding: 0; }
      li.todo { padding: 0.4rem 0; border-bottom: 1px solid #e4e4e7; }
      li.todo .view, li.todo form { display: flex; align-items: center; gap: 0.5rem; }
      li.todo .title, li.todo form input { flex: 1; }
      li.todo.done .title { text-decoration: line-through; color: #a1a1aa; }
      .error { background: #fef2f2; border: 1px solid #fca5a5; padding: 0.75rem; border-radius: 0.25rem; }
      .htmx-request { opacity: 0.5; }
      [x-cloak] { display: none !important; }
    </style>
  </head>
  <body>
    <main>
      <div id="errors" x-data @htmx:before-request.window="$el.replaceChildren()"></div>
      {% block content %}{% endblock %}
    </main>
  </body>
</html>
